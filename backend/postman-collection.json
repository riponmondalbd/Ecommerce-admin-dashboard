      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Get JWT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.data) {",
                  "    pm.collectionVariables.set(\"access_token\", jsonData.data.accessToken);",
                  "    pm.collectionVariables.set(\"refresh_token\", jsonData.data.refreshToken);",
                  "    console.log('Token stored:', jsonData.data.accessToken);",
                  "}",
                  "else {",
                  "    console.log('Error:', jsonData.message || pm.response.text());",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"email\": \"admin@trends-bird.com\", \"password\": \"admin123\" }" },
            "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{ \"refreshToken\": \"{{refresh_token}}\" }" },
            "url": { "raw": "{{base_url}}/auth/refresh", "host": ["{{base_url}"], "path": ["auth", "refresh"] }
          }
        },
        {
          "name": "Get Current User (Me)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/me", "host": ["{{base_url}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Logout (Revoke Token)",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}" }] },
            "method": "POST",
            "header": [],
            "url": { "raw": "{{base_url}}/auth/logout", "host": ["{{base_url}"], "path": ["auth", "logout"] }
          }
        }
      ]
    },
