// =============================================================================
// E-Commerce Admin Dashboard — Database Schema
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CATALOG_MANAGER
  SUPPORT_AGENT
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  LOCKED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

// ─── User Model ───────────────────────────────────────────────────────────────

model User {
  id           String       @id @default(uuid()) @db.Uuid
  name         String
  email        String       @unique
  password     String       // bcrypt hashed
  phone        String?
  gender       String?
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String      @db.Uuid
  status       UserStatus   @default(ACTIVE)
  avatarUrl    String?
  lastLoginAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  refreshTokens RefreshToken[]
  media       Media[]      // Inverse of Media.uploadedBy

  @@index([email])
  @@index([roleId])
  @@index([status])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g. "Admin", "Catalog Manager"
  description String?
  isSystem    Boolean          @default(false) // system roles cannot be deleted/modified
  isActive    Boolean          @default(true)
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

// ─── Refresh Token Model (for JWT rotation) ──────────────────────────────────

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @db.Uuid
  expiresAt DateTime
  revoked   Boolean  @default(false)
  revokedAt DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ─── Permission & Role (RBAC) ────────────────────────────────────────────────

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique // e.g. "product:create"
  name        String           // e.g. "Create Product"
  description String?
  group       String           // Group name dynamically created
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@index([group])
  @@index([key])
  @@index([isActive])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  role         Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       String   @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId String   @db.Uuid

  createdAt    DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ─── Media Model ────────────────────────────────────────────────────────────

model Media {
  id            String           @id @default(uuid()) @db.Uuid
  fileName      String
  filePath      String
  publicUrl     String
  type          MediaType
  mimeType      String?
  size          Int
  width         Int?
  height        Int?
  thumbnailPath String?
  altText       String?
  title         String?
  metadata      Json?
  uploadedBy    User             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById  String           @db.Uuid
  status        MediaStatus      @default(PENDING)
  
  brands        Brand[]          // Inverse of Brand.media
  categories    Category[]       // Inverse of Category.media
  products      ProductMedia[]
  variants      VariantMedia[]
  
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([type])
  @@index([status])
  @@index([uploadedById])
  @@map("media")
}

enum MediaStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

// ─── Category Model (Nested Tree) ──────────────────────────────────────────────

model Category {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  description String?
  mediaId     String?          @db.Uuid
  media       Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  parentId    String?          @db.Uuid
  parent      Category?        @relation("CategoryParents", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]       @relation("CategoryParents")
  products    Product[]        @relation("ProductToCategory")
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([parentId])
  @@index([slug])
  @@map("categories")
}

// ─── Brand Model ───────────────────────────────────────────────────────────────

model Brand {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  slug        String           @unique
  description String?
  status      BrandStatus      @default(ACTIVE)
  mediaId     String?          @db.Uuid
  media       Media?           @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  products    Product[]        // Inverse of Product.brand
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status])
  @@index([mediaId])
  @@map("brands")
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

// ─── Attribute Types ────────────────────────────────────────────────────────────

enum AttributeType {
  TEXT
  DROPDOWN
  RADIO
  CHECKBOX
  COLOR_SWATCH
  IMAGE_SWATCH
}

// ─── Attribute Model ────────────────────────────────────────────────────────────

model Attribute {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique // e.g. "Color", "Size"
  slug        String           @unique
  type        AttributeType    @default(TEXT)
  description String?
  attributeValues AttributeValue[] // Inverse of AttributeValue.attribute
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([type])
  @@map("attributes")
}

// ─── Attribute Value Model ───────────────────────────────────────────────────────

model AttributeValue {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  label          String           // Display value like "Red", "L"
  referenceValue String?          // Internal code like "#FF0000", "L"
  sortOrder      Int              @default(0)
  attribute      Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  attributeId    String           @db.Uuid
  productAttributeValues ProductAttributeValue[] // Inverse of ProductAttributeValue.attributeValue

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([attributeId])
  @@map("attribute_values")
}

// ─── Product Model ───────────────────────────────────────────────────────────────

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  name             String
  slug             String           @unique
  sku              String?          @unique // Unique stock keeping unit (may be auto-generated)
  shortDescription String?
  description      String?
  hasVariants      Boolean          @default(false)
  price            Decimal
  salePrice        Decimal?
  stock            Int              @default(0)
  stockStatus      String?
  weight           Decimal?
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  sortOrder        Int              @default(0)
  
  brand            Brand?           @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandId          String?          @db.Uuid
  categories       Category[]       @relation("ProductToCategory")
  
  status           ProductStatus    @default(DRAFT)
  variants         ProductVariant[] // Inverse of ProductVariant.product
  mediaAttachments ProductMedia[]
  transactions     ProductTransaction[] // Inverse of ProductTransaction.product
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([status])
  @@index([brandId])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ProductMedia {
  id          String   @id @default(uuid()) @db.Uuid
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String   @db.Uuid
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId     String   @db.Uuid
  isThumbnail Boolean  @default(false)
  isGallery   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  
  @@map("product_media")
}

// ─── Product Variant Model ──────────────────────────────────────────────────────

model ProductVariant {
  id                String           @id @default(uuid()) @db.Uuid
  productId         String           @db.Uuid
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku               String?          @unique // Unique variant SKU
  price             Decimal?         // Variant-specific price (overrides product base price)
  salePrice         Decimal?
  inventory         Int              @default(0) // Stock quantity
  stockStatus       String?
  lowStockThreshold Int              @default(5)
  weight            Decimal?          // Optional weight for shipping
  dimensions        Json?             // Optional width, height, depth
  isActive          Boolean          @default(true)

  attributeValues   ProductAttributeValue[] // Inverse of ProductAttributeValue.productVariant
  mediaAttachments  VariantMedia[]
  transactions      ProductTransaction[] // Inverse of ProductTransaction.variant

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([productId])
  @@map("product_variants")
}

model VariantMedia {
  id          String   @id @default(uuid()) @db.Uuid
  variant     ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String   @db.Uuid
  media       Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  mediaId     String   @db.Uuid
  isThumbnail Boolean  @default(false)
  isGallery   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  
  @@map("variant_media")
}

// ─── Product Attribute Value Pair (junction table for many-to-many) ───────────

model ProductAttributeValue {
  id            String             @id @default(uuid()) @db.Uuid
  productVariantId String         @db.Uuid
  productVariant ProductVariant   @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  attributeValueId String         @db.Uuid
  attributeValue AttributeValue   @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([productVariantId, attributeValueId])
  @@map("product_attribute_values")
}

// ─── Product Transaction Model ──────────────────────────────────────────────────

model ProductTransaction {
  id          String           @id @default(uuid()) @db.Uuid
  variantId   String?          @db.Uuid
  variant     ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  productId   String           @db.Uuid
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  type        TransactionType  // create, update, sell, restock, etc.
  quantity    Int              // Number of units affected
  priceAtTime Decimal          // Price at time of transaction
  notes       String?          // Optional description
  createdBy   String?          @db.Uuid // User ID who initiated
  createdAt   DateTime         @default(now())

  @@index([productId, variantId, type])
  @@index([createdAt])
  @@map("product_transactions")
}

enum TransactionType {
  CREATE
  UPDATE
  DELETE
  SELL
  RESTOCK
  ADJUST
  TRANSFER
}
